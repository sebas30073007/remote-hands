---
/**
 * Patrón de metadatos de SEBS: label en Manrope Medium 12px +
 * dato en IBM Plex Mono 12px (typography.md §4).
 *
 * Candidata a @sebs/docs-core (§29 del brief).
 */
interface Props {
  label: string;
  /** El dato. Si se omite, se usa el slot. */
  value?: string | number;
  /** `false` para datos que son lenguaje y no dato técnico. */
  mono?: boolean;
}

const { label, value, mono = true } = Astro.props;
---

<div class="c-meta">
  <span class="c-meta__label">{label}</span>
  <span class:list={['c-meta__value', { 'c-meta__value--mono': mono }]}>
    {value ?? <slot />}
  </span>
</div>
