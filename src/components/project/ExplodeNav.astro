---
/**
 * Navegación por vista explosionada.
 *
 * Sustituye al temario de lista cuando el modo UI/UX está activo
 * (`data-ui="explosion"` en `<html>`, ver `UiModeToggle.astro`). La pestaña
 * «Sistema» dibuja el robot; al elegir una pieza, la página cambia y el
 * dibujo se separa en las piezas de esa parte. Las otras cinco pestañas son
 * árboles de páginas: Reporte, Operar, Construir, Evidencia y Referencia no
 * son cosas que se puedan desmontar.
 *
 * Cómo está hecho, y por qué:
 *
 *  - Las imágenes son capas renderizadas desde el CAD con cámara ortográfica
 *    (`scripts/render-explode.mjs`). Explotar es trasladarlas con CSS:
 *    exacto, a 60 fps, y sin WebGL en un panel que está en todas las páginas.
 *  - El dibujo ES la navegación. No hay listado de piezas: cada pieza es un
 *    enlace, su globo es el objetivo de teclado, y al señalarla el rótulo al
 *    pie del lienzo dice qué es. El nombre de ese rótulo es el mismo de las
 *    migas y del título de la página (`explode-nav.ts`).
 *  - Un nodo se alcanza por varias rutas y el panel recuerda por cuál vino
 *    (ver `explode-nav.ts`). El servidor dibuja la ruta canónica; el script
 *    la sustituye por la real al navegar.
 *  - El panel lleva `transition:persist`: con `<ClientRouter />` sobrevive a
 *    la navegación, y por eso puede animar del estado anterior al nuevo en
 *    vez de reaparecer desde cero en cada clic.
 */
import manifiesto from '../../generated/explode-manifest.json';
import {
  NODOS,
  PESTANAS,
  nodoPorId,
  duenoDeEscena,
  rutaCanonica,
  escenaDeRuta,
  type NodoExplode,
} from '../../lib/explode-nav';

type Entrada =
  | { type: 'link'; label: string; href: string; isCurrent: boolean }
  | { type: 'group'; label: string; entries: Entrada[] };

interface Props {
  sidebar: Entrada[];
  pathname: string;
}

const { sidebar, pathname } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (slug: string) => `${base}${slug}/`;
const normal = (p: string) => {
  let s = decodeURI(p.split('#')[0].split('?')[0]);
  if (!s.endsWith('/')) s += '/';
  return s;
};
const actual = normal(pathname);

/* --- Temario clásico: etiquetas y árboles de las pestañas ------------ */
const etiquetas = new Map<string, string>();
const aplanar = (es: Entrada[]) =>
  es.forEach((e) => (e.type === 'link' ? etiquetas.set(normal(e.href), e.label) : aplanar(e.entries)));
aplanar(sidebar);

const raizSidebar = sidebar.length === 1 && sidebar[0].type === 'group' ? sidebar[0].entries : sidebar;
const grupoPorEtiqueta = (label: string) =>
  raizSidebar.find((e): e is Extract<Entrada, { type: 'group' }> => e.type === 'group' && e.label === label);

/* --- Mapa página -> estado ------------------------------------------- */
type Estado = { tab: string; nodo: string | null; explotada: boolean };
const estados: Record<string, Estado> = {};
estados[normal(base)] = { tab: 'sistema', nodo: 'sistema', explotada: false };
for (const n of NODOS) {
  estados[normal(href(n.pagina))] = { tab: 'sistema', nodo: n.id, explotada: true };
  for (const f of n.facetas ?? []) estados[normal(href(f))] ??= { tab: 'sistema', nodo: n.id, explotada: true };
}
for (const p of PESTANAS) {
  const recorrer = (es: Entrada[]) =>
    es.forEach((e) => {
      if (e.type === 'link') estados[normal(e.href)] ??= { tab: p.id, nodo: null, explotada: false };
      else recorrer(e.entries);
    });
  const g = grupoPorEtiqueta(p.grupo);
  if (g) recorrer(g.entries);
}
const inicial: Estado = estados[actual] ?? { tab: 'sistema', nodo: 'sistema', explotada: false };
const rutaInicial = rutaCanonica(inicial.nodo ?? 'sistema');
const { escena: escenaInicial, resaltadas: resaltadasIniciales } = escenaDeRuta(rutaInicial);

/* --- Piezas de cada escena ------------------------------------------- */
const piezaDe = (dueno: NodoExplode, capa: string) => {
  const d = dueno.piezas?.[capa];
  if (!d) return null;
  const nodo = d.nodo ? nodoPorId.get(d.nodo) : undefined;
  return {
    capa,
    nodo: nodo?.id ?? null,
    nombre: d.nombre ?? nodo?.nombre ?? capa,
    descripcion: d.descripcion ?? nodo?.descripcion ?? '',
    href: nodo ? href(nodo.pagina) : `${href(d.pagina ?? dueno.pagina)}${d.ancla ? `#${d.ancla}` : ''}`,
  };
};

const { w: LW, h: LH } = manifiesto.lienzo;
const escenas = Object.entries(manifiesto.escenas).map(([id, esc]) => {
  const dueno = duenoDeEscena(id);
  return {
    id,
    dueno,
    ensamble: esc.ensamble,
    capas: esc.capas.map((c) => ({ ...c, pieza: piezaDe(dueno, c.id) })),
  };
});

const puntos = (anillo: number[][]) => anillo.map(([x, y]) => `${x},${y}`).join(' ');
const r2 = (n: number) => Math.round(n * 100) / 100;
const rotuloDe = (p: { nombre: string; descripcion: string }) =>
  p.descripcion ? `${p.nombre} (${p.descripcion})` : p.nombre;

/* --- Globos: el número fuera de la pieza, unido por una línea guía ----
   Como en un plano de despiece, el número sale de la pieza con una línea
   guía y todos los globos van en una capa por encima de las piezas. La
   posición se calcula aquí, al compilar: se prueba la dirección que se aleja
   del centro del conjunto y, si el globo cae sobre una pieza, se sale del
   escenario o choca con otro globo, se gira de 30 en 30 grados.

   Unidades: `cqw`, porcentaje del ANCHO del escenario en los dos ejes, para
   que la distancia sea la misma en horizontal y en vertical. */
const RATIO = LH / LW;
const LARGO = 12;
const RADIO = 2.8;
type Punto = [number, number];
type CapaGeo = (typeof escenas)[number]['capas'][number];

const dentroDe = ([x, y]: Punto, anillo: Punto[]) => {
  let dentro = false;
  for (let i = 0, j = anillo.length - 1; i < anillo.length; j = i++) {
    const [xi, yi] = anillo[i];
    const [xj, yj] = anillo[j];
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) dentro = !dentro;
  }
  return dentro;
};

const colocarNotas = (capas: CapaGeo[]) => {
  const aEscenario = (c: CapaGeo, [px, py]: number[]): Punto => [
    c.box[0] + (px * c.box[2]) / 100 + c.dx,
    (c.box[1] + (py * c.box[3]) / 100 + c.dy) * RATIO,
  ];
  const anclas = capas.map((c) => aEscenario(c, c.globo));
  const cx = anclas.reduce((a, [x]) => a + x, 0) / anclas.length;
  const cy = anclas.reduce((a, [, y]) => a + y, 0) / anclas.length;
  const siluetas = capas.map((c) => c.poly.map((anillo) => anillo.map((pt) => aEscenario(c, pt))));
  const sobrePieza = (pt: Punto) => siluetas.some((anillos) => anillos.some((an) => dentroDe(pt, an)));

  const puestos: Punto[] = [];
  const notas = new Map<string, { ox: number; oy: number; len: number; ang: number }>();
  capas.forEach((c, i) => {
    if (!c.pieza) return;
    const [ax, ay] = anclas[i];
    const rumbo = Math.hypot(ax - cx, ay - cy) < 1 ? -Math.PI / 4 : Math.atan2(ay - cy, ax - cx);
    let elegido: Punto | null = null;
    for (const estricto of [true, false]) {
      for (let k = 0; k < 12 && !elegido; k++) {
        const giro = Math.ceil(k / 2) * (k % 2 ? 1 : -1) * (Math.PI / 6);
        for (const largo of [LARGO, LARGO * 1.5]) {
          const b: Punto = [ax + largo * Math.cos(rumbo + giro), ay + largo * Math.sin(rumbo + giro)];
          if (b[0] < 5 || b[0] > 95 || b[1] < 5 || b[1] > 100 * RATIO - 5) continue;
          if (puestos.some(([px, py]) => Math.hypot(px - b[0], py - b[1]) < 7)) continue;
          if (estricto && sobrePieza(b)) continue;
          elegido = b;
          break;
        }
      }
      if (elegido) break;
    }
    elegido ??= [
      Math.min(95, Math.max(5, ax + LARGO * Math.cos(rumbo))),
      Math.min(100 * RATIO - 5, Math.max(5, ay + LARGO * Math.sin(rumbo))),
    ];
    puestos.push(elegido);
    const ox = elegido[0] - ax;
    const oy = elegido[1] - ay;
    notas.set(c.id, { ox, oy, len: Math.max(0, Math.hypot(ox, oy) - RADIO), ang: (Math.atan2(oy, ox) * 180) / Math.PI });
  });
  return notas;
};
const notasDe = new Map(escenas.map((e) => [e.id, colocarNotas(e.capas)]));

/* --- Datos para el script ------------------------------------------- */
const datos = {
  estados,
  nodos: Object.fromEntries(
    NODOS.map((n) => [
      n.id,
      { nombre: n.nombre, descripcion: n.descripcion, padre: n.padre ?? null, escena: n.escena ?? null, href: href(n.pagina) },
    ])
  ),
  piezas: Object.fromEntries(
    escenas.map((e) => [
      e.id,
      Object.fromEntries(
        e.capas
          .filter((c) => c.pieza)
          .map((c) => [c.id, { nodo: c.pieza!.nodo, nombre: c.pieza!.nombre, descripcion: c.pieza!.descripcion }])
      ),
    ])
  ),
  duenos: Object.fromEntries(escenas.map((e) => [e.id, e.dueno.id])),
  geometria: Object.fromEntries(
    escenas.map((e) => [
      e.id,
      {
        ensamble: e.ensamble.box,
        capas: Object.fromEntries(e.capas.map((c) => [c.id, { box: c.box, dx: c.dx, dy: c.dy, oculto: c.oculto }])),
      },
    ])
  ),
};
---

<div
  class="c-xnav"
  data-xnav
  data-ruta={JSON.stringify(rutaInicial)}
  data-pestana={inicial.tab}
  data-explotada={String(inicial.explotada)}
  transition:persist="xnav"
  transition:animate="none"
>
  <div class="c-xnav__tabs" role="tablist" aria-label="Secciones">
    {
      [{ id: 'sistema', etiqueta: 'Sistema' }, ...PESTANAS].map((t) => (
        <button
          type="button"
          role="tab"
          class="c-xnav__tab"
          id={`xnav-tab-${t.id}`}
          aria-controls={`xnav-panel-${t.id}`}
          aria-selected={String(t.id === inicial.tab)}
          tabindex={t.id === inicial.tab ? 0 : -1}
          data-tab={t.id}
        >
          {t.etiqueta}
        </button>
      ))
    }
  </div>

  {/* ------------------------------------------------ Pestaña Sistema */}
  <div
    class="c-xnav__panel"
    role="tabpanel"
    id="xnav-panel-sistema"
    aria-labelledby="xnav-tab-sistema"
    data-panel="sistema"
    hidden={inicial.tab !== 'sistema'}
  >
    {/* Migas de la ruta real. El servidor pone la canónica; el script la
        reescribe con la ruta por la que se llegó. */}
    <nav class="c-xnav__migas" aria-label="Ubicación en el sistema" data-migas>
      {
        rutaInicial.map((id, i) => {
          const n = nodoPorId.get(id)!;
          return (
            <>
              {i > 0 && (
                <span class="c-xnav__sep" aria-hidden="true">
                  /
                </span>
              )}
              {i < rutaInicial.length - 1 ? (
                <a href={href(n.pagina)} data-migas-idx={i}>
                  {n.nombre}
                </a>
              ) : (
                <span class="c-xnav__aqui">{n.nombre}</span>
              )}
            </>
          );
        })
      }
    </nav>

    <div class="c-xnav__stage" role="group" aria-label="Vista explosionada" style={`aspect-ratio:${LW}/${LH}`}>
      {
        escenas.map((e) => {
          const visible = e.id === escenaInicial;
          return (
            <div
              class="c-xnav__escena"
              data-escena={e.id}
              data-visible={String(visible)}
              data-explotada={String(visible && inicial.explotada)}
            >
              <div
                class="c-xnav__ens"
                style={`--x:${e.ensamble.box[0]}%;--y:${e.ensamble.box[1]}%;--w:${e.ensamble.box[2]}%;--h:${e.ensamble.box[3]}%`}
              >
                <img
                  src={`${base}${e.ensamble.src}`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width={Math.round((e.ensamble.box[2] / 100) * LW)}
                  height={Math.round((e.ensamble.box[3] / 100) * LH)}
                />
                <svg class="c-xnav__hit" viewBox="0 0 100 100" preserveAspectRatio="none">
                  <a href={href(e.dueno.pagina)} aria-label={`Explorar: ${rotuloDe(e.dueno)}`} data-ensamble={e.id}>
                    {e.ensamble.poly.map((anillo) => <polygon points={puntos(anillo)} />)}
                  </a>
                </svg>
              </div>

              {e.capas.map((c) => (
                <div
                  class="c-xnav__capa"
                  data-capa={c.id}
                  data-activa={visible && resaltadasIniciales.includes(c.id) ? 'true' : undefined}
                  style={
                    `--x:${c.box[0]}%;--y:${c.box[1]}%;--w:${c.box[2]}%;--h:${c.box[3]}%;` +
                    `--tx:${r2((c.dx / c.box[2]) * 100)}%;--ty:${r2((c.dy / c.box[3]) * 100)}%;z-index:${c.z + 1}`
                  }
                >
                  <img
                    src={`${base}${c.src}`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={Math.round((c.box[2] / 100) * LW)}
                    height={Math.round((c.box[3] / 100) * LH)}
                  />
                  {c.pieza && (
                    <svg class="c-xnav__hit" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                      <a href={c.pieza.href} tabindex="-1" data-capa-ref={c.id}>
                        {c.poly.map((anillo) => <polygon points={puntos(anillo)} />)}
                      </a>
                    </svg>
                  )}
                </div>
              ))}

              {/* Globos y líneas guía: por encima de todas las piezas, pero
                  cada nota se mueve con la suya. El globo es el objetivo de
                  teclado de la pieza. */}
              <div class="c-xnav__notas">
                {e.capas
                  .filter((c) => c.pieza)
                  .map((c, i) => {
                    const nota = notasDe.get(e.id)!.get(c.id)!;
                    return (
                      <div
                        class="c-xnav__nota"
                        data-capa={c.id}
                        data-activa={visible && resaltadasIniciales.includes(c.id) ? 'true' : undefined}
                        style={
                          `--x:${c.box[0]}%;--y:${c.box[1]}%;--w:${c.box[2]}%;--h:${c.box[3]}%;` +
                          `--tx:${r2((c.dx / c.box[2]) * 100)}%;--ty:${r2((c.dy / c.box[3]) * 100)}%;` +
                          `--gx:${c.globo[0]}%;--gy:${c.globo[1]}%;--ox:${r2(nota.ox)};--oy:${r2(nota.oy)};` +
                          `--len:${r2(nota.len)};--ang:${r2(nota.ang)}deg`
                        }
                      >
                        <span class="c-xnav__guia" />
                        <a class="c-xnav__globo" href={c.pieza!.href} data-capa-ref={c.id} aria-label={rotuloDe(c.pieza!)}>
                          {i + 1}
                        </a>
                      </div>
                    );
                  })}
              </div>
            </div>
          );
        })
      }

      {/* Rótulo al pie del lienzo: qué es la pieza señalada. */}
      <p class="c-xnav__rotulo" data-rotulo aria-live="polite">
        {inicial.explotada ? 'Señala una pieza' : 'Toca el robot para desmontarlo'}
      </p>
    </div>

    <div class="c-xnav__facetas">
      {
        NODOS.filter((n) => n.facetas?.length).map((n) => (
          <div class="c-xnav__info" data-info={n.id} hidden={n.id !== rutaInicial[rutaInicial.length - 1]}>
            <p class="c-xnav__titulo">Documentos</p>
            <ul class="c-xnav__etiquetas">
              {n.facetas!.map((slug) => (
                <li>
                  <a href={href(slug)} aria-current={normal(href(slug)) === actual ? 'page' : undefined}>
                    {etiquetas.get(normal(href(slug))) ?? slug}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  {/* ---------------------------------------- Pestañas de árbol */}
  {
    PESTANAS.map((p) => {
      const g = grupoPorEtiqueta(p.grupo);
      return (
        <div
          class="c-xnav__panel"
          role="tabpanel"
          id={`xnav-panel-${p.id}`}
          aria-labelledby={`xnav-tab-${p.id}`}
          data-panel={p.id}
          hidden={inicial.tab !== p.id}
        >
          {/* Mismo lenguaje que el temario clásico: carpeta raíz, tronco y
              codos. Una sección de lista se lee como un directorio. */}
          <p class="c-xnav__raiz">{p.etiqueta}</p>
          <ul class="c-xnav__arbol">
            {(g?.entries ?? []).map((e) =>
              e.type === 'link' ? (
                <li>
                  <a href={e.href} aria-current={normal(e.href) === actual ? 'page' : undefined}>
                    {e.label}
                  </a>
                </li>
              ) : (
                <li class="c-xnav__subgrupo">
                  <span class="c-xnav__carpeta">{e.label}</span>
                  <ul class="c-xnav__arbol">
                    {e.entries
                      .flatMap((sub) =>
                        sub.type === 'link'
                          ? [sub]
                          : sub.entries.filter((x): x is Extract<Entrada, { type: 'link' }> => x.type === 'link')
                      )
                      .map((x) => (
                        <li>
                          <a href={x.href} aria-current={normal(x.href) === actual ? 'page' : undefined}>
                            {x.label}
                          </a>
                        </li>
                      ))}
                  </ul>
                </li>
              )
            )}
          </ul>
        </div>
      );
    })
  }

  <script type="application/json" data-xnav-datos set:html={JSON.stringify(datos)} />
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  type Estado = { tab: string; nodo: string | null; explotada: boolean };
  type Caja = [number, number, number, number];
  type Datos = {
    estados: Record<string, Estado>;
    nodos: Record<string, { nombre: string; descripcion: string; padre: string | null; escena: string | null; href: string }>;
    piezas: Record<string, Record<string, { nodo: string | null; nombre: string; descripcion: string }>>;
    duenos: Record<string, string>;
    geometria: Record<
      string,
      { ensamble: Caja; capas: Record<string, { box: Caja; dx: number; dy: number; oculto: boolean }> }
    >;
  };

  const EASE = 'cubic-bezier(0.4, 0, 0.2, 1)';

  const normal = (p: string) => {
    let s = decodeURI(p.split('#')[0].split('?')[0]);
    if (!s.endsWith('/')) s += '/';
    return s;
  };

  function iniciar() {
    const raiz = document.querySelector<HTMLElement>('[data-xnav]');
    // Persistido entre páginas: los listeners de la primera carga siguen
    // vivos, y enlazarlos otra vez duplicaría cada evento.
    if (!raiz || raiz.dataset.listo) return;
    raiz.dataset.listo = '1';

    const datos: Datos = JSON.parse(raiz.querySelector('[data-xnav-datos]')!.textContent!);
    const stage = raiz.querySelector<HTMLElement>('.c-xnav__stage')!;
    const rotulo = raiz.querySelector<HTMLElement>('[data-rotulo]')!;
    const migas = raiz.querySelector<HTMLElement>('[data-migas]')!;
    const escenaEl = (id: string) => raiz.querySelector<HTMLElement>(`.c-xnav__escena[data-escena="${id}"]`)!;
    const escenaVisible = () =>
      raiz.querySelector<HTMLElement>('.c-xnav__escena[data-visible="true"]')?.dataset.escena ?? 'sistema';
    const sinMovimiento = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const visible = () => raiz.getClientRects().length > 0;

    /* --- Rutas ------------------------------------------------------- */
    const canonica = (id: string) => {
      const out: string[] = [];
      let n: string | null = id;
      while (n && datos.nodos[n]) {
        out.unshift(n);
        n = datos.nodos[n].padre;
      }
      return out;
    };
    const capasHacia = (escena: string, nodo: string) =>
      Object.entries(datos.piezas[escena] ?? {})
        .filter(([, p]) => p.nodo === nodo)
        .map(([capa]) => capa);
    const escenaDe = (ruta: string[]) => {
      const ultimo = ruta[ruta.length - 1];
      const n = datos.nodos[ultimo];
      if (!n) return { escena: 'sistema', resaltadas: [] as string[] };
      if (n.escena) return { escena: n.escena, resaltadas: [] as string[] };
      const previo = datos.nodos[ruta[ruta.length - 2] ?? n.padre ?? 'sistema'];
      const escena = previo?.escena ?? 'sistema';
      return { escena, resaltadas: capasHacia(escena, ultimo) };
    };
    const leerRuta = (): string[] => JSON.parse(raiz.dataset.ruta ?? '["sistema"]');

    /**
     * La ruta a la que se llega. Si el clic que causó la navegación dejó una
     * ruta pendiente y termina en el nodo de la página nueva, esa manda: así
     * el mismo nodo conserva el camino por el que se llegó. Si no, se intenta
     * seguir la ruta anterior (retroceder, o bajar un nivel desde la escena
     * visible) y, en último caso, la canónica.
     */
    let pendiente: string[] | null = null;
    const resolverRuta = (nodo: string, previa: string[]) => {
      if (pendiente && pendiente[pendiente.length - 1] === nodo) return pendiente;
      const i = previa.indexOf(nodo);
      if (i >= 0) return previa.slice(0, i + 1);
      const { escena } = escenaDe(previa);
      if (capasHacia(escena, nodo).length) {
        const j = previa.indexOf(datos.duenos[escena]);
        if (j >= 0) return [...previa.slice(0, j + 1), nodo];
      }
      return canonica(nodo);
    };

    /* --- Migas y rótulo ---------------------------------------------- */
    const pintarMigas = (ruta: string[]) => {
      migas.replaceChildren(
        ...ruta.flatMap((id, i) => {
          const n = datos.nodos[id];
          const partes: Node[] = [];
          if (i > 0) {
            const sep = document.createElement('span');
            sep.className = 'c-xnav__sep';
            sep.setAttribute('aria-hidden', 'true');
            sep.textContent = '/';
            partes.push(sep);
          }
          if (i < ruta.length - 1) {
            const a = document.createElement('a');
            a.href = n.href;
            a.dataset.migasIdx = String(i);
            a.textContent = n.nombre;
            partes.push(a);
          } else {
            const s = document.createElement('span');
            s.className = 'c-xnav__aqui';
            s.textContent = n.nombre;
            partes.push(s);
          }
          return partes;
        })
      );
    };
    const ponerRotulo = (texto: string | null) => {
      rotulo.textContent =
        texto ?? (raiz.dataset.explotada === 'true' ? 'Señala una pieza' : 'Toca el robot para desmontarlo');
      rotulo.classList.toggle('is-pieza', Boolean(texto));
    };

    /* --- Geometría para el zoom entre escenas ------------------------ */
    type Rect = { x: number; y: number; w: number; h: number };
    const rectCapa = (escena: string, capa: string, explotada: boolean): Rect | null => {
      const c = datos.geometria[escena]?.capas[capa];
      if (!c) return null;
      return { x: c.box[0] + (explotada ? c.dx : 0), y: c.box[1] + (explotada ? c.dy : 0), w: c.box[2], h: c.box[3] };
    };
    const rectEns = (escena: string): Rect => {
      const b = datos.geometria[escena].ensamble;
      return { x: b[0], y: b[1], w: b[2], h: b[3] };
    };
    /** Transformación (origen 0 0) que lleva el rect `a` sobre el rect `b`. */
    const mapear = (a: Rect, b: Rect) => {
      const W = stage.clientWidth;
      const H = stage.clientHeight;
      const k = (b.w / a.w + b.h / a.h) / 2;
      const acx = ((a.x + a.w / 2) / 100) * W;
      const acy = ((a.y + a.h / 2) / 100) * H;
      const bcx = ((b.x + b.w / 2) / 100) * W;
      const bcy = ((b.y + b.h / 2) / 100) * H;
      return `translate(${bcx - k * acx}px, ${bcy - k * acy}px) scale(${k})`;
    };

    /* --- Utilidades de estado ---------------------------------------- */
    const instantaneo = (el: HTMLElement, fn: () => void) => {
      el.classList.add('is-instantanea');
      fn();
      void el.offsetWidth;
      el.classList.remove('is-instantanea');
    };
    const cancelar = () =>
      raiz.querySelectorAll<HTMLElement>('.c-xnav__escena').forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
    const mostrarSolo = (id: string, explotada: boolean) =>
      raiz.querySelectorAll<HTMLElement>('.c-xnav__escena').forEach((el) => {
        const es = el.dataset.escena === id;
        instantaneo(el, () => {
          el.dataset.visible = String(es);
          el.dataset.explotada = String(es && explotada);
          el.style.zIndex = '';
        });
      });
    // `[data-capa]` cubre la pieza y su globo, que viven en capas distintas.
    const resaltar = (escena: string, capas: string[]) =>
      escenaEl(escena)
        .querySelectorAll<HTMLElement>('[data-capa]')
        .forEach((c) => (capas.includes(c.dataset.capa!) ? (c.dataset.activa = 'true') : delete c.dataset.activa));

    const ponerPestana = (tab: string, enfocar = false) => {
      raiz.dataset.pestana = tab;
      raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((b) => {
        const si = b.dataset.tab === tab;
        b.setAttribute('aria-selected', String(si));
        b.tabIndex = si ? 0 : -1;
        if (si && enfocar) b.focus();
      });
      raiz.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== tab));
    };

    /* --- Transiciones entre escenas ---------------------------------- */
    const zoom = (desde: string, desdeExpl: boolean, hacia: string, capa: string, sentido: 'baja' | 'sube') => {
      const elA = escenaEl(desde);
      const elB = escenaEl(hacia);
      if (sentido === 'baja') {
        // La pieza elegida crece hasta ocupar el lugar del conjunto de
        // abajo, que aparece encima de ella y se explota al llegar.
        const L = rectCapa(desde, capa, desdeExpl)!;
        const E = rectEns(hacia);
        instantaneo(elB, () => {
          elB.dataset.explotada = 'false';
          elB.dataset.visible = 'true';
        });
        elA.style.zIndex = '1';
        elB.style.zIndex = '2';
        elA.animate([{ transform: 'none', opacity: 1 }, { transform: mapear(L, E), opacity: 0 }], {
          duration: 280,
          easing: EASE,
        }).onfinish = () => {
          elA.dataset.visible = 'false';
          elA.dataset.explotada = 'false';
          elA.style.zIndex = elB.style.zIndex = '';
        };
        elB.animate(
          [{ transform: mapear(E, L), opacity: 0 }, { opacity: 1, offset: 0.35 }, { transform: 'none', opacity: 1 }],
          { duration: 280, easing: EASE }
        );
        setTimeout(() => (elB.dataset.explotada = 'true'), 150);
      } else {
        // Al revés: el conjunto actual se pliega y encoge hasta su sitio en
        // la escena de arriba, que llega explotada desde un zoom.
        const L = rectCapa(hacia, capa, true)!;
        const E = rectEns(desde);
        instantaneo(elB, () => {
          elB.dataset.visible = 'true';
          elB.dataset.explotada = 'true';
        });
        elA.style.zIndex = '2';
        elB.style.zIndex = '1';
        elA.dataset.explotada = 'false';
        elA.animate([{ transform: 'none', opacity: 1 }, { transform: mapear(E, L), opacity: 0 }], {
          duration: 360,
          delay: 60,
          easing: EASE,
          fill: 'backwards',
        }).onfinish = () => {
          elA.dataset.visible = 'false';
          elA.style.zIndex = elB.style.zIndex = '';
        };
        elB.animate(
          [{ transform: mapear(L, E), opacity: 0 }, { opacity: 1, offset: 0.4 }, { transform: 'none', opacity: 1 }],
          { duration: 360, delay: 60, easing: EASE, fill: 'backwards' }
        );
      }
    };

    const fundido = (desde: string, hacia: string) => {
      const elA = escenaEl(desde);
      const elB = escenaEl(hacia);
      instantaneo(elB, () => {
        elB.dataset.explotada = 'false';
        elB.dataset.visible = 'true';
      });
      elA.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 180, easing: EASE }).onfinish = () => {
        elA.dataset.visible = 'false';
        elA.dataset.explotada = 'false';
      };
      elB.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 180, easing: EASE });
      setTimeout(() => (elB.dataset.explotada = 'true'), 110);
    };

    const aplicar = (previa: string[], prevExpl: boolean, next: Estado, animar: boolean) => {
      ponerPestana(next.tab);

      const aqui = normal(location.pathname);
      raiz.querySelectorAll<HTMLAnchorElement>('.c-xnav__facetas a[href], .c-xnav__arbol a[href]').forEach((a) => {
        const h = a.getAttribute('href')!;
        if (!h.includes('#') && normal(h) === aqui) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });

      // Una página de árbol no mueve la escena: al volver a la pestaña
      // Sistema se ve donde se quedó.
      if (!next.nodo) return;

      const ruta = resolverRuta(next.nodo, previa);
      pendiente = null;
      raiz.dataset.ruta = JSON.stringify(ruta);
      raiz.dataset.explotada = String(next.explotada);
      pintarMigas(ruta);
      ponerRotulo(null);
      raiz
        .querySelectorAll<HTMLElement>('[data-info]')
        .forEach((el) => (el.hidden = el.dataset.info !== ruta[ruta.length - 1]));

      const n = escenaDe(ruta);
      const p = escenaDe(previa);
      resaltar(n.escena, n.resaltadas);
      cancelar();
      if (!animar) return mostrarSolo(n.escena, next.explotada);
      if (p.escena === n.escena) {
        const el = escenaEl(n.escena);
        el.dataset.visible = 'true';
        el.dataset.explotada = String(next.explotada);
        return;
      }
      // Bajar: la escena nueva es de un nodo que la escena anterior dibuja
      // como pieza. Subir: al revés. Cualquier otro salto, fundido.
      const capaBaja = capasHacia(p.escena, datos.duenos[n.escena])[0];
      if (capaBaja) {
        const oculto = datos.geometria[p.escena].capas[capaBaja]?.oculto;
        if (oculto && !prevExpl) return fundido(p.escena, n.escena);
        return zoom(p.escena, prevExpl, n.escena, capaBaja, 'baja');
      }
      const capaSube = capasHacia(n.escena, datos.duenos[p.escena])[0];
      if (capaSube) return zoom(p.escena, true, n.escena, capaSube, 'sube');
      fundido(p.escena, n.escena);
    };

    // El puntero se queda donde hizo clic, y lo que quede debajo en la
    // página nueva no debe arrastrar el resalte de la anterior.
    const limpiarHover = () => raiz.querySelectorAll<HTMLElement>('[data-hover]').forEach((el) => delete el.dataset.hover);

    const sincronizar = (animar: boolean) => {
      limpiarHover();
      const next: Estado = datos.estados[normal(location.pathname)] ?? { tab: 'sistema', nodo: 'sistema', explotada: false };
      aplicar(leerRuta(), raiz.dataset.explotada === 'true', next, animar && visible() && !sinMovimiento());
    };

    /* --- Señalar piezas: resalte y rótulo ---------------------------- */
    const marcar = (ref: string | undefined, si: boolean) => {
      if (!ref) return;
      const escena = escenaVisible();
      escenaEl(escena)
        .querySelectorAll<HTMLElement>(`[data-capa="${ref}"]`)
        .forEach((c) => (si ? (c.dataset.hover = 'true') : delete c.dataset.hover));
      const pieza = datos.piezas[escena]?.[ref];
      ponerRotulo(si && pieza ? (pieza.descripcion ? `${pieza.nombre} (${pieza.descripcion})` : pieza.nombre) : null);
    };
    const refDe = (t: EventTarget | null) =>
      (t as Element | null)?.closest?.<HTMLElement>('[data-capa-ref]')?.dataset.capaRef;
    stage.addEventListener('pointerover', (e) => marcar(refDe(e.target), true));
    stage.addEventListener('pointerout', (e) => marcar(refDe(e.target), false));
    stage.addEventListener('focusin', (e) => {
      const ref = refDe(e.target);
      if (ref) return marcar(ref, true);
      const ens = (e.target as Element).closest<Element>('[data-ensamble]');
      if (ens) {
        const dueno = datos.nodos[datos.duenos[ens.getAttribute('data-ensamble')!]];
        ponerRotulo(`${dueno.nombre} (${dueno.descripcion})`);
      }
    });
    stage.addEventListener('focusout', (e) => {
      const ref = refDe(e.target);
      if (ref) marcar(ref, false);
      else ponerRotulo(null);
    });

    /* --- Clics: la ruta viaja con el clic ---------------------------- */
    raiz.addEventListener(
      'click',
      (e) => {
        const a = (e.target as Element).closest<Element>('a');
        if (!a || !raiz.contains(a)) return;
        const ruta = leerRuta();
        const miga = a.getAttribute('data-migas-idx');
        const ref = a.getAttribute('data-capa-ref');
        const escena = escenaVisible();

        if (miga != null) {
          pendiente = ruta.slice(0, Number(miga) + 1);
        } else if (ref) {
          const pieza = datos.piezas[escena]?.[ref];
          const dueno = datos.duenos[escena];
          const j = ruta.indexOf(dueno);
          const prefijo = j >= 0 ? ruta.slice(0, j + 1) : canonica(dueno);
          if (pieza?.nodo) pendiente = [...prefijo, pieza.nodo];
          // Una sección de la página actual no cambia de nodo: la pieza se
          // resalta en su sitio.
          else resaltar(escena, [ref]);
        } else if (a.hasAttribute('data-ensamble')) {
          pendiente = canonica(datos.duenos[a.getAttribute('data-ensamble')!]);
        }

        // Los `<a>` dentro de SVG no siempre los intercepta el router: se
        // navega a mano para conservar la transición.
        if (a instanceof SVGElement) {
          e.preventDefault();
          navigate(a.getAttribute('href')!);
        }
      },
      true
    );

    document.addEventListener('astro:after-swap', () => sincronizar(true));

    raiz.querySelector('[role="tablist"]')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (b) ponerPestana(b.dataset.tab!);
    });
    raiz.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
      const tabs = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const i = tabs.findIndex((t) => t.dataset.tab === raiz.dataset.pestana);
      const j = (i + (ev.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      ponerPestana(tabs[j].dataset.tab!, true);
      ev.preventDefault();
    });

    sincronizar(false);
  }

  document.addEventListener('astro:page-load', iniciar);
</script>
