---
/**
 * Diagrama de conexiones en cadena — el estándar del sitio para mostrar qué
 * se conecta con qué y por dónde.
 *
 * Cada componente es una tarjeta con su render 3D grande y, debajo, su
 * nombre y un dato técnico. Entre tarjetas va el tramo, que se lee siempre
 * igual:
 *
 *   medio          ← por dónde viaja (puerto, bus, dirección)
 *   ─────────▶     ← UNA línea, con punta hacia donde viaja la información
 *   → lo que va    ← la carga, con la flecha apuntando en pantalla hacia
 *   ← lo que vuelve   su destino
 *
 * Uso:
 * <SignalChain
 *   pasos={[{ nombre: 'NUC', detalle: 'Python 3.12', imagen: '/images/3d/nuc.webp', href: '/…/' }, …]}
 *   enlaces={['Serial · COM4', { medio: 'ZMQ por WiFi', ida: 'comandos', vuelta: 'video' }, …]}
 * />
 *
 * `enlaces` va ENTRE pasos consecutivos: siempre uno menos que pasos. Un
 * texto es solo el medio, con la punta hacia el paso siguiente; un objeto
 * `{ medio, ida, vuelta }` describe lo que viaja en cada sentido (`ida`,
 * hacia el paso siguiente; `vuelta`, de regreso).
 *
 * Opcionales por paso:
 *  - `href`: la tarjeta lleva a esa página.
 *  - `ramas`: componentes que cuelgan de ese paso fuera de la cadena —los
 *    finales de carrera de una placa—, dibujados debajo de su tarjeta. Su
 *    `enlace` usa `ida` para lo que baja del paso a la rama y `vuelta` para
 *    lo que sube de la rama al paso.
 *
 * `porFila` (3 por defecto) fija cuántas tarjetas caben por fila; cuando la
 * cadena sigue abajo, el tramo es un codo que baja de la última tarjeta y
 * entra a la primera de la fila siguiente. En pantalla estrecha todo se
 * apila en una columna.
 */
type Enlace = string | { medio?: string; ida?: string; vuelta?: string };

interface Componente {
  nombre: string;
  /** Qué corre o qué es, en mono: dato técnico. */
  detalle?: string;
  /** Ruta desde la raíz del sitio. */
  imagen: string;
}

interface Paso extends Componente {
  href?: string;
  ramas?: (Componente & { enlace: Enlace })[];
}

interface Props {
  pasos: Paso[];
  enlaces: Enlace[];
  porFila?: number;
  caption?: string;
}

const { pasos, enlaces, porFila = 3, caption } = Astro.props;

if (enlaces.length !== pasos.length - 1) {
  throw new Error(`SignalChain: ${pasos.length} pasos necesitan ${pasos.length - 1} enlaces, se recibieron ${enlaces.length}.`);
}

type Normal = { medio?: string; ida?: string; vuelta?: string; soloMedio?: boolean };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const conBase = (ruta: string) => (ruta.startsWith('/') && !ruta.startsWith('//') ? `${base}${ruta}` : ruta);
const normalizar = (e: Enlace): Normal => (typeof e === 'string' ? { medio: e, soloMedio: true } : e);
const sentidoDe = (e: Normal) =>
  e.soloMedio || (e.ida && !e.vuelta) ? 'ida' : e.vuelta && !e.ida ? 'vuelta' : e.ida && e.vuelta ? 'doble' : 'ida';

const columnas = Math.min(porFila, pasos.length);
// Una fila: tarjeta, tramo, tarjeta, tramo… (2n − 1 columnas).
const plantilla = Array.from({ length: columnas }, () => 'minmax(0, 1fr)').join(' auto ');

// Ramas agrupadas por fila: se dibujan en una fila propia, bajo su tarjeta.
const filas = Math.ceil(pasos.length / columnas);
const ramasDeFila = Array.from({ length: filas }, (_, f) =>
  pasos.map((p, i) => ({ p, i })).filter(({ p, i }) => p.ramas?.length && Math.floor(i / columnas) === f)
);
---

<figure class="c-chain not-content" style={`--chain-cols:${plantilla}`}>
  <ol class="c-chain__lista">
    {
      pasos.map((paso, i) => {
        const enlace = i < enlaces.length ? normalizar(enlaces[i]) : null;
        const fila = Math.floor(i / columnas);
        const finDeFila = (i + 1) % columnas === 0 || i === pasos.length - 1;
        // El tramo que sigue a la última tarjeta de una fila cambia de fila.
        const cambiaFila = enlace && columnas > 1 && (i + 1) % columnas === 0;
        const Tarjeta = paso.href ? 'a' : 'div';
        return (
          <>
            <li class="c-chain__celda" style={`--orden:${i * 10}`}>
              <Tarjeta class="c-chain__paso" href={paso.href ? conBase(paso.href) : undefined}>
                <img class="c-chain__img" src={conBase(paso.imagen)} alt="" loading="lazy" decoding="async" />
                <span class="c-chain__nombre">{paso.nombre}</span>
                {paso.detalle && <span class="c-chain__detalle">{paso.detalle}</span>}
              </Tarjeta>
            </li>

            {finDeFila && ramasDeFila[fila].length > 0 && (
              <li class="c-chain__ramas">
                {ramasDeFila[fila].map(({ p, i: j }) => (
                  <div class="c-chain__ramas-col" style={`--col:${(j % columnas) * 2 + 1};--orden:${j * 10 + 2}`}>
                    {p.ramas!.map((r) => {
                      const e = normalizar(r.enlace);
                      return (
                        <div class="c-chain__rama">
                          <div class="c-chain__tramo c-chain__tramo--vertical" data-sentido={sentidoDe(e)}>
                            <span class="c-chain__linea" aria-hidden="true" />
                            <span class="c-chain__textos">
                              {e.medio && <span class="c-chain__medio">{e.medio}</span>}
                              {e.ida && (
                                <span class="c-chain__senal c-chain__senal--ida">
                                  <span class="c-chain__sentido">
                                    {p.nombre} → {r.nombre}:{' '}
                                  </span>
                                  {e.ida}
                                </span>
                              )}
                              {e.vuelta && (
                                <span class="c-chain__senal c-chain__senal--vuelta">
                                  <span class="c-chain__sentido">
                                    {r.nombre} → {p.nombre}:{' '}
                                  </span>
                                  {e.vuelta}
                                </span>
                              )}
                            </span>
                          </div>
                          <div class="c-chain__paso c-chain__paso--mini">
                            <img class="c-chain__img" src={conBase(r.imagen)} alt="" loading="lazy" decoding="async" />
                            <span class="c-chain__texto">
                              <span class="c-chain__nombre">{r.nombre}</span>
                              {r.detalle && <span class="c-chain__detalle">{r.detalle}</span>}
                            </span>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                ))}
              </li>
            )}

            {enlace && (
              <li
                class:list={['c-chain__tramo', { 'c-chain__tramo--fila': cambiaFila }]}
                data-sentido={sentidoDe(enlace)}
                style={`--orden:${i * 10 + 5}`}
              >
                {cambiaFila && (
                  <>
                    <span class="c-chain__codo c-chain__codo--sale" aria-hidden="true" />
                    <span class="c-chain__codo c-chain__codo--fin" aria-hidden="true" />
                    <span class="c-chain__codo c-chain__codo--cruce" aria-hidden="true" />
                    <span class="c-chain__codo c-chain__codo--ini" aria-hidden="true" />
                    <span class="c-chain__codo c-chain__codo--entra" aria-hidden="true" />
                  </>
                )}
                <span class="c-chain__textos">
                  {enlace.medio && <span class="c-chain__medio">{enlace.medio}</span>}
                  <span class="c-chain__linea" aria-hidden="true" />
                  {(enlace.ida || enlace.vuelta) && (
                    <span class="c-chain__carga">
                      {enlace.ida && (
                        <span class="c-chain__senal c-chain__senal--ida">
                          <span class="c-chain__sentido">
                            {paso.nombre} → {pasos[i + 1].nombre}:{' '}
                          </span>
                          {enlace.ida}
                        </span>
                      )}
                      {enlace.vuelta && (
                        <span class="c-chain__senal c-chain__senal--vuelta">
                          <span class="c-chain__sentido">
                            {pasos[i + 1].nombre} → {paso.nombre}:{' '}
                          </span>
                          {enlace.vuelta}
                        </span>
                      )}
                    </span>
                  )}
                </span>
              </li>
            )}
          </>
        );
      })
    }
  </ol>
  {caption && <figcaption class="c-chain__caption">{caption}</figcaption>}
</figure>
